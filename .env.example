# ==============================================================================
# Webhook Ingestion Engine - Environment Variables Template
# Copy this file to '.env' and populate with your secure local secrets.
# ==============================================================================

# Core Application Settings
APP_ENV=development
LOG_LEVEL=INFO

# Security Guardrails
WEBHOOK_SECRET_TOKEN=your_secure_agency_webhook_secret_here

# Database Settings
DATABASE_URL=sqlite:///./src/webhook_data.db
